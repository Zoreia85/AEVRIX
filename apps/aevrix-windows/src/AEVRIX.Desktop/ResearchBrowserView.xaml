<UserControl
    x:Class="AEVRIX.Desktop.ResearchBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="40,32" RowSpacing="16" MaxWidth="1440" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Text="NAVEGADOR DE PESQUISA" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
            <TextBlock Text="Abra o site do projeto com isolamento" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="Selecione o projeto e navegue apenas dentro dos endereços permitidos. Sessão, histórico e cookies permanecem isolados por projeto." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="BrowserNotice"
                 Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="A navegação segue a política do projeto"
                 Message="O AEVRIX bloqueia saídas da allowlist HTTPS, downloads e novas janelas quando a política não permitir. Abrir o navegador não autoriza captura nem uso de credenciais por si só." />

        <Border Grid.Row="2" Background="{StaticResource AevrixPanelBrush}" BorderBrush="{StaticResource AevrixBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProjectSelector"
                              Grid.Column="0"
                              Header="Projeto"
                              PlaceholderText="Selecione um projeto"
                              SelectionChanged="ProjectSelector_SelectionChanged"
                              AutomationProperties.Name="Selecionar projeto do Research Browser" />
                    <TextBox x:Name="AddressInput"
                             Grid.Column="1"
                             Header="Endereço"
                             PlaceholderText="O endereço inicial vem do projeto e pode ser ajustado dentro da política"
                             KeyDown="AddressInput_KeyDown"
                             AutomationProperties.Name="Endereço do Research Browser" />
                    <Button Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Content="Abrir"
                            Background="{StaticResource AevrixAccentBrush}"
                            Foreground="White"
                            Click="OpenAddressButton_Click"
                            AutomationProperties.Name="Abrir endereço permitido" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="Voltar" Click="BackButton_Click" IsEnabled="False" />
                    <Button x:Name="ForwardButton" Grid.Column="1" Content="Avançar" Click="ForwardButton_Click" IsEnabled="False" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Content="Recarregar" Click="ReloadButton_Click" IsEnabled="False" />
                    <Button x:Name="HomeButton" Grid.Column="3" Content="Página inicial" Click="HomeButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="BrowserStatusText"
                               Grid.Column="4"
                               Text="Selecione um projeto para começar."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource AevrixPanelBrush}" BorderBrush="{StaticResource AevrixBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="2" MinHeight="480">
            <Grid x:Name="BrowserHost">
                <StackPanel x:Name="BrowserEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="620">
                    <TextBlock Text="Selecione um projeto para começar" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Se ainda não houver projeto Web, comece em Nova investigação. Quando o projeto estiver pronto, o endereço inicial e os limites de navegação aparecerão aqui." Opacity="0.68" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
