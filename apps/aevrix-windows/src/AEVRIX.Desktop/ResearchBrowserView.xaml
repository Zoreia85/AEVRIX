<UserControl
    x:Class="AEVRIX.Desktop.ResearchBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="14" MaxWidth="1440" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Text="RESEARCH BROWSER" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
            <TextBlock Text="Navegação isolada por projeto" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Cada projeto web usa sua própria pasta de sessão do WebView2. Navegação fora da allowlist HTTPS é cancelada antes de sair do limite governado." FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="BrowserNotice"
                 Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Host interativo governado"
                 Message="Abrir o Research Browser não autoriza credenciais, captura ou automação. Downloads e novas janelas ficam bloqueados nesta etapa; autenticação automática permanece sujeita aos gates do projeto." />

        <Border Grid.Row="2" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProjectSelector"
                              Grid.Column="0"
                              Header="Projeto web"
                              PlaceholderText="Selecione um projeto"
                              SelectionChanged="ProjectSelector_SelectionChanged"
                              AutomationProperties.Name="Selecionar projeto do Research Browser" />
                    <TextBox x:Name="AddressInput"
                             Grid.Column="1"
                             Header="Endereço HTTPS"
                             PlaceholderText="https://portal.exemplo.com/"
                             KeyDown="AddressInput_KeyDown"
                             AutomationProperties.Name="Endereço do Research Browser" />
                    <Button Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Content="Abrir"
                            Click="OpenAddressButton_Click"
                            AutomationProperties.Name="Abrir endereço permitido" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="Voltar" Click="BackButton_Click" IsEnabled="False" />
                    <Button x:Name="ForwardButton" Grid.Column="1" Content="Avançar" Click="ForwardButton_Click" IsEnabled="False" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Content="Recarregar" Click="ReloadButton_Click" IsEnabled="False" />
                    <Button x:Name="HomeButton" Grid.Column="3" Content="Entrada do projeto" Click="HomeButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="BrowserStatusText"
                               Grid.Column="4"
                               Text="Nenhum projeto carregado."
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="2" MinHeight="480">
            <Grid x:Name="BrowserHost">
                <StackPanel x:Name="BrowserEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Research Browser aguardando projeto" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Somente projetos Web com política de navegador válida podem inicializar uma sessão." Opacity="0.65" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>