<Window
    x:Class="AEVRIX.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AevrixSurfaceBrush}">
        <NavigationView
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneTitle="AEVRIX"
            SelectionChanged="RootNavigation_SelectionChanged"
            AutomationProperties.Name="Navegação principal do AEVRIX">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Command Center" Tag="home" IsSelected="True" />
                <NavigationViewItem Content="Projetos" Tag="projects" />
                <NavigationViewItem x:Name="NewInvestigationNavItem" Content="Nova investigação" Tag="new" />
                <NavigationViewItem x:Name="MissionControlNavItem" Content="Mission Control" Tag="mission" />
                <NavigationViewItem Content="Evidências" Tag="evidence" />
                <NavigationViewItem Content="Blueprint" Tag="blueprint" />
                <NavigationViewItem Content="Research Browser" Tag="browser" />
                <NavigationViewItem Content="Especialistas / Adapters" Tag="specialists" />
                <NavigationViewItem x:Name="ActivityNavItem" Content="Activity / Proof Ledger" Tag="activity" />
                <NavigationViewItem Content="Integrações" Tag="integrations" />
                <NavigationViewItem Content="Configurações / Segurança" Tag="settings" />
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="CommandCenterView">
                    <Grid Padding="32" RowSpacing="24" MaxWidth="1320" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="COMMAND CENTER" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                            <TextBlock Text="Centro operacional" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Visão governada da estação Windows, do cérebro remoto e das missões em execução." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Warning" Title="NOT_HOMOLOGATED" Message="Este shell é uma superfície em desenvolvimento. Estados não verificados permanecem restritos ou indisponíveis." />

                        <Grid Grid.Row="2" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="EngineHost" FontWeight="SemiBold" />
                                    <TextBlock x:Name="EngineHostStatusText" Text="Não iniciado" FontSize="22" />
                                    <TextBlock x:Name="EngineHostDetailText" Text="Sem prova de sessão autenticada nesta tela." Opacity="0.65" TextWrapping="Wrap" />
                                    <TextBlock Text="Liveness: 1 s • prova autenticada: 5 s" Opacity="0.5" TextWrapping="Wrap" />
                                    <Button x:Name="VerifyEngineHostButton" Content="Verificar EngineHost" HorizontalAlignment="Left" Click="VerifyEngineHostButton_Click" AutomationProperties.Name="Verificar EngineHost autenticado" />
                                    <Button x:Name="RestartEngineHostButton" Content="Reiniciar EngineHost" HorizontalAlignment="Left" Click="RestartEngineHostButton_Click" AutomationProperties.Name="Reiniciar EngineHost supervisionado" />
                                    <Button x:Name="StopEngineHostButton" Content="Parar EngineHost" HorizontalAlignment="Left" IsEnabled="False" Click="StopEngineHostButton_Click" AutomationProperties.Name="Parar EngineHost supervisionado" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Cérebro remoto" FontWeight="SemiBold" />
                                    <TextBlock Text="Não verificado" FontSize="22" />
                                    <TextBlock Text="Conectividade e identidade ainda não foram consultadas." Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Postura de segurança" FontWeight="SemiBold" />
                                    <TextBlock Text="Restrita" FontSize="22" />
                                    <TextBlock Text="Nenhum gate de runtime é inferido pela interface." Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Missões" FontWeight="SemiBold" />
                                    <TextBlock Text="0 ativas" FontSize="22" />
                                    <TextBlock Text="Nenhuma missão é inferida sem vínculo real com o orquestrador." Opacity="0.65" TextWrapping="Wrap" />
                                    <Button Content="Abrir Mission Control" HorizontalAlignment="Left" Click="OpenMissionControlButton_Click" AutomationProperties.Name="Abrir Mission Control" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Começar trabalho autorizado" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="O fluxo de investigação somente pode avançar depois de escopo, autorização e sensibilidade serem validados." Opacity="0.72" TextWrapping="Wrap" />
                                    <Button x:Name="StartAnalysisButton" Content="Preparar nova análise autorizada" HorizontalAlignment="Left" Click="StartAnalysisButton_Click" AutomationProperties.Name="Preparar nova análise autorizada" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Próximos gates" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="• Integridade no primeiro launch" TextWrapping="Wrap" />
                                    <TextBlock Text="• Enrollment e autenticação" TextWrapping="Wrap" />
                                    <TextBlock Text="• Estado real do EngineHost" TextWrapping="Wrap" />
                                    <TextBlock Text="• Estado real do cérebro remoto" TextWrapping="Wrap" />
                                    <TextBlock Text="• Política real de investigação" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="4" Text="AEVRIX Desktop • build de desenvolvimento • evidência antes de confiança" Opacity="0.5" HorizontalAlignment="Center" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="NewInvestigationView" Visibility="Collapsed">
                    <Grid Padding="32" RowSpacing="24" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="NOVA INVESTIGAÇÃO" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                            <TextBlock Text="Preparar escopo autorizado" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Defina contexto e intenção antes de qualquer coleta, execução ou instrumentação." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Warning" Title="Execução bloqueada por padrão" Message="Esta tela ainda não está vinculada ao motor de políticas. Preencher campos não concede autorização e não inicia uma missão." />

                        <Border Grid.Row="2" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="18">
                                <TextBlock Text="1. Escopo e autorização" FontSize="22" FontWeight="SemiBold" />
                                <ComboBox x:Name="AuthorizationClassInput" Header="Classe de autorização" PlaceholderText="Selecione a classe declarada" AutomationProperties.Name="Classe de autorização">
                                    <ComboBoxItem Content="Sistema próprio" Tag="owned" />
                                    <ComboBoxItem Content="Explicitamente autorizado" Tag="authorized" />
                                    <ComboBoxItem Content="Terceiro — clean-room" Tag="clean-room" />
                                </ComboBox>
                                <TextBox x:Name="WorkspaceInput" Header="Projeto / workspace" PlaceholderText="Identificador do workspace" AutomationProperties.Name="Projeto ou workspace" />
                                <TextBox x:Name="TargetInput" Header="Alvo ou fonte" PlaceholderText="Arquivo, aplicação, repositório, API ou outra fonte autorizada" TextWrapping="Wrap" AutomationProperties.Name="Alvo ou fonte" />
                                <TextBox x:Name="GoalsInput" Header="Objetivos da análise" PlaceholderText="O que precisa ser observado, validado ou reconstruído?" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" AutomationProperties.Name="Objetivos da análise" />
                                <ComboBox x:Name="SensitivityInput" Header="Sensibilidade dos dados" PlaceholderText="Selecione a política de dados" AutomationProperties.Name="Sensibilidade dos dados">
                                    <ComboBoxItem Content="Padrão" Tag="standard" />
                                    <ComboBoxItem Content="Confidencial" Tag="confidential" />
                                    <ComboBoxItem Content="Dados pessoais / restritos" Tag="restricted" />
                                </ComboBox>
                                <Border Height="1" Background="{StaticResource AevrixAccentBrush}" Opacity="0.2" />
                                <TextBlock Text="Etapas seguintes quando a política estiver conectada: plano de especialistas/adapters → revisão → validação de autoridade → início governado." Opacity="0.7" TextWrapping="Wrap" />
                                <Button Content="Validar escopo e autorização" HorizontalAlignment="Left" Click="ValidateScopeButton_Click" AutomationProperties.Name="Validar escopo e autorização" />
                                <InfoBar x:Name="PolicyUnavailableNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Validação ainda indisponível" Message="O motor real de políticas ainda não está conectado a esta superfície. Nenhuma autorização foi concedida e nenhuma missão foi criada." />
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="3" Content="Voltar ao Command Center" HorizontalAlignment="Left" Click="BackToHomeButton_Click" AutomationProperties.Name="Voltar ao Command Center" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="MissionControlView" Visibility="Collapsed">
                    <Grid Padding="32" RowSpacing="24" MaxWidth="1180" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="MISSION CONTROL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                            <TextBlock Text="Estado operacional verificável" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Acompanhe somente estados que a aplicação consegue sustentar com evidência local. Capacidades remotas continuam bloqueadas até integração real." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="Fail-closed" Message="Ausência de prova nunca é convertida em estado saudável. O painel distingue explicitamente não verificado, autenticado, interrompido e bloqueado." />

                        <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="EngineHost local" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MissionEngineStatusText" Text="Não iniciado" FontSize="26" />
                                    <TextBlock x:Name="MissionEngineDetailText" Text="Nenhuma sessão autenticada foi comprovada." Opacity="0.68" TextWrapping="Wrap" />
                                    <Button Content="Gerenciar no Command Center" HorizontalAlignment="Left" Click="BackToHomeButton_Click" AutomationProperties.Name="Gerenciar EngineHost no Command Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Cérebro remoto" FontWeight="SemiBold" />
                                    <TextBlock Text="Não verificado" FontSize="26" />
                                    <TextBlock Text="Endpoint, identidade, sessão e política remota ainda não estão vinculados a esta superfície." Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Fila de missões" FontWeight="SemiBold" />
                                    <TextBlock Text="0 ativas" FontSize="26" />
                                    <TextBlock Text="Nenhuma fila é simulada. A contagem permanecerá zero até existir vínculo real com o orquestrador." Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Modo de execução" FontWeight="SemiBold" />
                                    <TextBlock Text="Local supervisionado" FontSize="26" />
                                    <TextBlock Text="O shell pode supervisionar o EngineHost local. O modo remoto permanece indisponível até autenticação e política serem comprovadas." Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button Grid.Row="3" Content="Abrir Activity" HorizontalAlignment="Left" Click="OpenActivityButton_Click" AutomationProperties.Name="Abrir atividade operacional" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="ActivityView" Visibility="Collapsed">
                    <Grid Padding="32" RowSpacing="20" MaxWidth="1080" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock Text="ACTIVITY" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                            <TextBlock Text="Histórico operacional amigável" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="Resumo local e limitado dos eventos desta sessão para diagnóstico do usuário, sem expor payloads, segredos ou dados brutos." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="Não é o Proof Ledger canônico" Message="Esta visualização é efêmera e orientada ao usuário. Evidência auditável persistente deve vir do ledger governado quando ele estiver conectado." />

                        <Border Grid.Row="2" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Eventos desta sessão" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="Mais recente primeiro • retenção limitada em memória" Opacity="0.6" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Atualizar" Click="RefreshActivityButton_Click" AutomationProperties.Name="Atualizar atividade operacional" />
                                </Grid>
                                <TextBlock x:Name="ActivityEmptyStateText" Text="Nenhum evento registrado nesta sessão." Opacity="0.65" Visibility="Collapsed" />
                                <ListView x:Name="ActivityListView" MaxHeight="520" AutomationProperties.Name="Eventos operacionais da sessão" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="3" Content="Voltar ao Command Center" HorizontalAlignment="Left" Click="BackToHomeButton_Click" AutomationProperties.Name="Voltar ao Command Center" />
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="PlannedSectionView" Visibility="Collapsed" Padding="32">
                    <Border Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="28" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="PlannedSectionTitle" Text="Superfície em preparação" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="Esta área consta no sistema canônico de UX, mas ainda não possui implementação promovida. Nenhuma capacidade é simulada como disponível." Opacity="0.72" TextWrapping="Wrap" />
                            <Button Content="Voltar ao Command Center" HorizontalAlignment="Left" Click="BackToHomeButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>