<Window
    x:Class="AEVRIX.Desktop.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AevrixSurfaceBrush}" Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="18">
                <TextBlock Text="PRIMEIRA EXECUÇÃO" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                <TextBlock Text="Autorização e termos operacionais" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Antes de usar o AEVRIX, confirme as condições operacionais desta versão." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />

                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Title="NOT_HOMOLOGATED"
                    Message="Esta versão permanece em validação. Estados sem prova continuam bloqueados e nenhum aceite nesta tela concede autorização de investigação, autenticação remota ou autoridade de execução." />

                <Border Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Condições desta versão" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="• Use o AEVRIX somente em sistemas, dados e ambientes próprios ou explicitamente autorizados." TextWrapping="Wrap" />
                        <TextBlock Text="• O produto opera fail-closed: ausência de evidência, autenticação ou política válida não é convertida em estado saudável." TextWrapping="Wrap" />
                        <TextBlock Text="• O aceite abaixo confirma apenas ciência destas condições locais de uso. Políticas de missão, credenciais, escopo e permissões continuam independentes." TextWrapping="Wrap" />
                        <TextBlock Text="• O AEVRIX registra evidências operacionais necessárias à auditabilidade da execução." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <CheckBox
                    x:Name="FirstRunConfirmCheckBox"
                    AutomationProperties.AutomationId="AevrixFirstRunConfirm"
                    AutomationProperties.Name="Confirmar condições da primeira execução"
                    Content="Li e compreendi as condições operacionais desta versão e desejo continuar."
                    Checked="FirstRunConfirmCheckBox_Changed"
                    Unchecked="FirstRunConfirmCheckBox_Changed" />

                <InfoBar
                    x:Name="FirstRunErrorNotice"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Error"
                    Title="Primeira execução bloqueada" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,24,0,0">
            <Button
                x:Name="DeclineFirstRunButton"
                AutomationProperties.AutomationId="AevrixFirstRunDecline"
                AutomationProperties.Name="Sair sem aceitar as condições"
                Content="Sair"
                Click="DeclineFirstRunButton_Click" />
            <Button
                x:Name="AcceptFirstRunButton"
                AutomationProperties.AutomationId="AevrixFirstRunAccept"
                AutomationProperties.Name="Aceitar condições e continuar"
                Content="Aceitar e continuar"
                IsEnabled="False"
                Click="AcceptFirstRunButton_Click" />
        </StackPanel>
    </Grid>
</Window>
