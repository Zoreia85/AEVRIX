<UserControl
    x:Class="AEVRIX.Desktop.Views.EvidenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="32" RowSpacing="18" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="EVIDENCE EXPLORER" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                <TextBlock Text="Evidência indexada com integridade verificável" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Consulta somente leitura do EvidenceStore canônico. Quarentena permanece metadados-only e não é aberta ou executada por esta superfície." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProjectInput" Grid.Column="0" Header="Projeto" PlaceholderText="Selecione um projeto local" SelectionChanged="ProjectInput_SelectionChanged" AutomationProperties.Name="Projeto das evidências" />
                <ComboBox x:Name="ClassificationInput" Grid.Column="1" Header="Classificação" SelectionChanged="ClassificationInput_SelectionChanged" AutomationProperties.Name="Classificação das evidências">
                    <ComboBoxItem Content="Todas" Tag="all" IsSelected="True" />
                    <ComboBoxItem Content="Sanitizadas" Tag="sanitized" />
                    <ComboBoxItem Content="Conhecimento neutro" Tag="knowledge" />
                    <ComboBoxItem Content="Quarentena" Tag="quarantine" />
                </ComboBox>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <Button x:Name="RefreshButton" Content="Atualizar índice" Click="RefreshButton_Click" AccessKey="R" AutomationProperties.Name="Atualizar índice de evidências" />
                <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Carregando evidências" />
                <TextBlock x:Name="StatusText" Text="Índice ainda não carregado." VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Warning" Title="Quarentena permanece isolada" Message="Selecionar quarentena expõe somente metadados. A verificação calcula SHA-256 sem abrir o conteúdo em outra aplicação." />

            <ListView x:Name="EvidenceList" Grid.Row="4" MaxHeight="420" SelectionMode="Single" HorizontalContentAlignment="Stretch" SelectionChanged="EvidenceList_SelectionChanged" AutomationProperties.Name="Evidências indexadas" />

            <Border Grid.Row="5" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Evidência selecionada" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectionDetailText" Text="Selecione uma evidência para inspecionar metadados e verificar integridade." Opacity="0.72" TextWrapping="Wrap" />
                    <Button x:Name="VerifyButton" Content="Verificar SHA-256" IsEnabled="False" HorizontalAlignment="Left" Click="VerifyButton_Click" AutomationProperties.Name="Verificar integridade SHA-256 da evidência" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
