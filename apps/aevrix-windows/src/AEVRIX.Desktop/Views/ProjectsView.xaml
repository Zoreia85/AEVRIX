<UserControl
    x:Class="AEVRIX.Desktop.Views.ProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="32" RowSpacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="PROJETOS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                <TextBlock Text="Projetos locais desta estação" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Leitura direta do ProjectRepository canônico. Esta superfície não cria projetos, não altera autorização e não inicia missões." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <Button x:Name="RefreshButton" Content="Atualizar catálogo" Click="RefreshButton_Click" AccessKey="R" AutomationProperties.Name="Atualizar catálogo local de projetos" />
                <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Carregando projetos" />
                <TextBlock x:Name="StatusText" Text="Catálogo ainda não carregado." VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <ListView x:Name="ProjectsList" Grid.Row="2" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Projetos locais" />

            <InfoBar Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Informational" Title="Somente leitura" Message="Abrir, alterar ou executar um projeto será habilitado somente depois que os gates de autorização e workspace estiverem integrados." />
        </Grid>
    </ScrollViewer>
</UserControl>
