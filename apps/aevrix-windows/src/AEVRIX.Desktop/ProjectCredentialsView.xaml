<UserControl
    x:Class="AEVRIX.Desktop.ProjectCredentialsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32" RowSpacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="PROJETOS • ACESSOS LOCAIS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                <TextBlock Text="Credenciais seguras por projeto" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="Cadastre os acessos necessários para sistemas autorizados. O AEVRIX associa cada conta ao projeto e à URL exata da tela de login, sem gravar usuário ou senha no project.json." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="Somente neste PC" Message="Usuário e senha ficam no Windows Credential Manager do usuário atual. Exportações, logs e sincronização do projeto não recebem o segredo. MFA/2FA continua sendo um gate separado." />

            <Grid Grid.Row="2" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Projeto e contas cadastradas" FontSize="22" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProjectSelector" Header="Projeto" PlaceholderText="Selecione um projeto" SelectionChanged="ProjectSelector_SelectionChanged" AutomationProperties.Name="Selecionar projeto para gerenciar credenciais" />
                        <TextBlock x:Name="ProjectDetailText" Text="Nenhum projeto selecionado." Opacity="0.65" TextWrapping="Wrap" />
                        <Border Height="1" Background="{StaticResource AevrixAccentBrush}" Opacity="0.2" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Logins salvos" FontWeight="SemiBold" />
                                <TextBlock Text="A senha nunca é exibida novamente nesta lista." Opacity="0.58" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Atualizar" Click="RefreshCredentialsButton_Click" AutomationProperties.Name="Atualizar lista de credenciais do projeto" />
                        </Grid>
                        <TextBlock x:Name="CredentialEmptyText" Text="Nenhum login cadastrado neste projeto." Opacity="0.65" />
                        <ListView x:Name="CredentialListView" MaxHeight="360" SelectionMode="Single" AutomationProperties.Name="Credenciais cadastradas no projeto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="3">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CanonicalLoginUri}" Opacity="0.68" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DefaultDescription}" Opacity="0.55" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Definir como padrão" Click="SetDefaultCredentialButton_Click" AutomationProperties.Name="Definir credencial selecionada como padrão para a URL" />
                            <Button Content="Excluir do PC" Click="DeleteCredentialButton_Click" AutomationProperties.Name="Excluir credencial selecionada deste computador" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource AevrixPanelBrush}" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Adicionar login ao projeto" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Use um apelido claro quando o mesmo sistema possuir mais de uma conta, por exemplo: Administrador, Financeiro, Operação ou Cliente A." Opacity="0.7" TextWrapping="Wrap" />
                        <TextBox x:Name="CredentialLabelInput" Header="Apelido da conta" PlaceholderText="Ex.: Administrador" MaxLength="80" AutomationProperties.Name="Apelido da credencial" />
                        <TextBox x:Name="LoginUriInput" Header="URL da tela de login" PlaceholderText="https://sistema.exemplo.com/login" AutomationProperties.Name="URL HTTPS da tela de login" />
                        <TextBox x:Name="UserNameInput" Header="Login / usuário" PlaceholderText="Usuário, e-mail ou identificador da conta" MaxLength="320" AutomationProperties.Name="Usuário da credencial" />
                        <PasswordBox x:Name="PasswordInput" Header="Senha" PlaceholderText="Senha armazenada somente no Windows" MaxLength="1024" AutomationProperties.Name="Senha da credencial" />
                        <CheckBox x:Name="DefaultCredentialCheckBox" Content="Usar esta conta automaticamente como padrão para esta URL" IsChecked="True" AutomationProperties.Name="Usar conta como padrão para a URL de login" />
                        <TextBlock Text="Ao iniciar uma execução autorizada, o preenchimento automático só poderá solicitar esta credencial quando a navegação atingir a URL cadastrada. Salvar a senha, por si só, não autoriza a leitura do cofre." Opacity="0.62" TextWrapping="Wrap" />
                        <Button x:Name="SaveCredentialButton" Content="Salvar com segurança neste PC" HorizontalAlignment="Left" Click="SaveCredentialButton_Click" AutomationProperties.Name="Salvar credencial segura no computador" />
                        <InfoBar x:Name="CredentialResultNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Credenciais do projeto" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Warning" Title="Autofill governado" Message="Esta tela cadastra o cofre local. O Research Browser só poderá usar um login durante execução autorizada e com a política de autofill habilitada; múltiplas contas sem padrão exigem escolha explícita." />
        </Grid>
    </ScrollViewer>
</UserControl>
