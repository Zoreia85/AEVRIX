<UserControl
    x:Class="AEVRIX.Desktop.ProjectCredentialsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="40,32" RowSpacing="20" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="7">
                <TextBlock Text="PROJETOS E ACESSOS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AevrixAccentBrush}" />
                <TextBlock Text="Organize os sistemas usados em cada investigação" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="Selecione um projeto e, somente se necessário, salve o login usado naquele sistema. O AEVRIX mantém a senha fora dos arquivos do projeto." FontSize="16" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="As senhas ficam neste Windows" Message="Credenciais são guardadas pelo Windows Credential Manager e não são incluídas em exportações, logs ou project.json." />

            <Grid Grid.Row="2" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AevrixPanelBrush}" BorderBrush="{StaticResource AevrixBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Projeto ativo" FontSize="22" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProjectSelector" Header="Projeto" PlaceholderText="Selecione um projeto" SelectionChanged="ProjectSelector_SelectionChanged" AutomationProperties.Name="Selecionar projeto para gerenciar credenciais" />
                        <TextBlock x:Name="ProjectDetailText" Text="Nenhum projeto local encontrado. Comece em Nova investigação; depois volte aqui apenas se o site exigir login." Opacity="0.68" TextWrapping="Wrap" />
                        <Border Height="1" Background="{StaticResource AevrixBorderBrush}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Contas salvas" FontWeight="SemiBold" />
                                <TextBlock Text="A senha nunca é mostrada novamente." Opacity="0.58" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Atualizar" Click="RefreshCredentialsButton_Click" AutomationProperties.Name="Atualizar lista de credenciais do projeto" />
                        </Grid>
                        <TextBlock x:Name="CredentialEmptyText" Text="Nenhuma conta salva neste projeto." Opacity="0.65" />
                        <ListView x:Name="CredentialListView" MaxHeight="360" SelectionMode="Single" AutomationProperties.Name="Credenciais cadastradas no projeto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="3">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CanonicalLoginUri}" Opacity="0.68" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DefaultDescription}" Opacity="0.55" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Usar como padrão" Click="SetDefaultCredentialButton_Click" AutomationProperties.Name="Definir credencial selecionada como padrão para a URL" />
                            <Button Content="Remover deste PC" Click="DeleteCredentialButton_Click" AutomationProperties.Name="Excluir credencial selecionada deste computador" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource AevrixPanelBrush}" BorderBrush="{StaticResource AevrixBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Salvar um login" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Use esta área somente quando o site do projeto exigir autenticação. O AEVRIX poderá sugerir a conta na URL correspondente durante uma execução autorizada." Opacity="0.7" TextWrapping="Wrap" />
                        <TextBox x:Name="CredentialLabelInput" Header="Nome para identificar a conta" PlaceholderText="Ex.: Administrador" MaxLength="80" AutomationProperties.Name="Apelido da credencial" />
                        <TextBox x:Name="LoginUriInput" Header="Página de login" PlaceholderText="https://sistema.exemplo.com/login" AutomationProperties.Name="URL HTTPS da tela de login" />
                        <TextBox x:Name="UserNameInput" Header="Usuário ou e-mail" PlaceholderText="Login da conta" MaxLength="320" AutomationProperties.Name="Usuário da credencial" />
                        <PasswordBox x:Name="PasswordInput" Header="Senha" PlaceholderText="Armazenada somente no Windows" MaxLength="1024" AutomationProperties.Name="Senha da credencial" />
                        <CheckBox x:Name="DefaultCredentialCheckBox" Content="Usar automaticamente esta conta como padrão para esta página" IsChecked="True" AutomationProperties.Name="Usar conta como padrão para a URL de login" />
                        <Button x:Name="SaveCredentialButton" Content="Salvar com segurança" HorizontalAlignment="Left" Background="{StaticResource AevrixAccentBrush}" Foreground="White" Click="SaveCredentialButton_Click" AutomationProperties.Name="Salvar credencial segura no computador" />
                        <InfoBar x:Name="CredentialResultNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Conta do projeto" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Informational" Title="Você continua no controle" Message="Salvar uma conta não autoriza uma investigação nem libera o cofre por si só. O uso de credenciais continua dependente do projeto e da execução autorizada." />
        </Grid>
    </ScrollViewer>
</UserControl>
